{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed x402 OpenAPI discovery fields",
  "type": "object",
  "required": [
    "x402Version"
  ],
  "additionalProperties": false,
  "properties": {
    "x402Version": {
      "const": 2
    },
    "price": {
      "$ref": "#/$defs/price"
    },
    "accepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/paymentOption"
      }
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "price": {
      "type": "object",
      "required": [
        "currency",
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "min": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "max": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        }
      }
    },
    "paymentOption": {
      "type": "object",
      "required": [
        "scheme",
        "network"
      ],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,8}:[-_a-zA-Z0-9]{1,32}$"
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "payTo": {
          "type": "string",
          "minLength": 1
        },
        "payToType": {
          "enum": [
            "address",
            "role",
            "stealth"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "payTo"
            ]
          },
          "then": {
            "required": [
              "payToType"
            ],
            "properties": {
              "payToType": {
                "enum": [
                  "address",
                  "role"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "payToType"
            ],
            "properties": {
              "payToType": {
                "enum": [
                  "address",
                  "role"
                ]
              }
            }
          },
          "then": {
            "required": [
              "payTo"
            ]
          }
        },
        {
          "if": {
            "required": [
              "payToType"
            ],
            "properties": {
              "payToType": {
                "const": "stealth"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "payTo"
              ]
            }
          }
        }
      ]
    }
  }
}
