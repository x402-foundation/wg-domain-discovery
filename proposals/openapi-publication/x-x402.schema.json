{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed x402 OpenAPI discovery fields",
  "description": "A static subset of the x402 v2 PaymentRequired object. Each field keeps its runtime meaning.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "accepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/paymentOption"
      }
    },
    "extensions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "$defs": {
    "atomicAmount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "paymentOption": {
      "type": "object",
      "required": [
        "scheme",
        "network"
      ],
      "additionalProperties": false,
      "properties": {
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "network": {
          "type": "string",
          "pattern": "^[a-z0-9-]{3,8}:[-_a-zA-Z0-9]{1,32}$"
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "minAmount": {
          "$ref": "#/$defs/atomicAmount"
        },
        "maxAmount": {
          "$ref": "#/$defs/atomicAmount"
        }
      },
      "dependentRequired": {
        "minAmount": [
          "maxAmount",
          "asset"
        ],
        "maxAmount": [
          "minAmount",
          "asset"
        ]
      }
    }
  }
}
